# Tracecase production environment contract
# Copy to product/.env.local for local work. Add the same names in Vercel.
# Never commit real values.

# Public deployment
NEXT_PUBLIC_APP_URL=

# Dashboard authentication (GitHub OAuth through Auth.js)
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
TRACECASE_ALLOWED_GITHUB_LOGINS=

# Tracecase runtime
TRACECASE_RUNTIME_MODE=live
TRACECASE_PERSISTENCE=mongodb
ALLOW_EXTERNAL_CALLS=true
TRACECASE_ORGANIZATION_ID=
TRACECASE_PROJECT_ID=
TRACECASE_PROJECT_NAME=
TRACECASE_PROJECT_SLUG=
TRACECASE_TARGET_TEST_URL=
RUN_MAX_MINUTES=15
MAX_PARALLEL_ENVIRONMENTS=12

# MongoDB Atlas
MONGODB_URI=
MONGODB_DATABASE=tracecase
MONGODB_APPLY_CHANGES=false

# Public reporter
NEXT_PUBLIC_WIDGET_PROJECT_KEY=
TRACECASE_WIDGET_ALLOWED_ORIGINS=
WIDGET_SIGNING_SECRET=

# Agent workers
WORKER_SIGNING_SECRET=
OTEL_INGEST_SECRET=

# Fireworks
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=

# Daytona
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=

# Optional observability import
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional ticket import
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Tracecase production environment contract
# Copy to product/.env.local for local work. Add the same names in Vercel.
# Never commit real values.

# Public deployment
NEXT_PUBLIC_APP_URL=

# Dashboard authentication (GitHub OAuth through Auth.js)
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
TRACECASE_ALLOWED_GITHUB_LOGINS=
TRACECASE_OWNER_EMAIL=

# Tracecase runtime
TRACECASE_RUNTIME_MODE=live
TRACECASE_PERSISTENCE=mongodb
ALLOW_EXTERNAL_CALLS=true
AUTO_DISPATCH_RUNS=true
TRACECASE_ORGANIZATION_ID=
TRACECASE_ORGANIZATION_NAME=
TRACECASE_ORGANIZATION_SLUG=
TRACECASE_PROJECT_ID=
TRACECASE_PROJECT_NAME=
TRACECASE_PROJECT_SLUG=
TRACECASE_TARGET_TEST_URL=
TRACECASE_TARGET_ALLOWED_DOMAINS=
TRACECASE_PRIVATE_SELECTORS=input[type=password],[data-private],[data-tracecase-mask]
RUN_MAX_MINUTES=15
MAX_PARALLEL_ENVIRONMENTS=12

# MongoDB Atlas
MONGODB_URI=
MONGODB_DATABASE=tracecase
MONGODB_APPLY_CHANGES=false

# Public reporter
NEXT_PUBLIC_WIDGET_PROJECT_KEY=
TRACECASE_WIDGET_ALLOWED_ORIGINS=
WIDGET_SIGNING_SECRET=

# Agent workers
WORKER_SIGNING_SECRET=
OTEL_INGEST_SECRET=
CRON_SECRET=
MCP_API_KEY=

# Fireworks
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=
# Optional. When set, isolated runs use this vision-capable model while reporter chat can use FIREWORKS_MODEL.
FIREWORKS_VISION_MODEL=

# Daytona
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us
DAYTONA_ORCHESTRATOR_IMAGE=node:22-bookworm
DAYTONA_BROWSER_IMAGE=mcr.microsoft.com/playwright:v1.55.0-noble
PLAYWRIGHT_VERSION=1.55.0

# Genuine desktop OS and physical mobile sessions (BrowserStack Automate)
REAL_DEVICE_PROVIDER=none
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=
TRACECASE_GITHUB_REPOSITORY_OWNER=
TRACECASE_GITHUB_REPOSITORY_NAME=
TRACECASE_GITHUB_DEFAULT_BRANCH=main
TRACECASE_GITHUB_INSTALLATION_ID=

# Release automation. Keep false until the proof gate and repository protections are ready.
ALLOW_AUTO_MERGE=false
ALLOW_AUTO_DEPLOY=false
VERCEL_DEPLOY_HOOK_URL=

# Optional observability import
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional ticket import
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
